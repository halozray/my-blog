---
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

const config = musicPlayerConfig;

const isFullUrl = (path: string) => /^https?:\/\//.test(path);

// 本地曲目：本地歌单来源与旧的 local 模式共用这份解析结果
const localPlaylist = (config.local?.playlist ?? []).map((song) => ({
	name: song.name,
	artist: song.artist,
	url: isFullUrl(song.url) ? song.url : url(song.url),
	pic: song.cover
		? isFullUrl(song.cover)
			? song.cover
			: url(song.cover)
		: undefined,
	lrc: song.lrc ? (isFullUrl(song.lrc) ? song.lrc : url(song.lrc)) : undefined,
}));

// 歌单来源：配置了 playlists 才有切换标签；未配置时保持旧的单歌单行为
const playlistSources = (config.playlists ?? []).map((source) => ({
	label: source.label,
	local: source.local === true,
	api: source.api === "self" ? "self" : "meting",
	server: source.server ?? config.meting?.server ?? "netease",
	id: source.id ?? "",
}));

const managerConfigStr = JSON.stringify({
	mode: config.mode,
	meting: config.meting,
	localPlaylist: localPlaylist,
	sources: playlistSources,
	volume: config.volume ?? 0.7,
	playMode: config.playMode ?? "list",
	i18n: {
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
	},
});
---

<script is:inline data-swup-ignore-script define:vars={{ managerConfigStr }}>
(function () {
    // Singleton guard – only create once
    if (window.__fireflyMusic) return;

    var config = JSON.parse(managerConfigStr);

    // ── Helpers ──────────────────────────────────────────────
    function formatTime(seconds) {
        if (!seconds || isNaN(seconds)) return '0:00';
        var min = Math.floor(seconds / 60);
        var sec = Math.floor(seconds % 60);
        return min + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function parseLRC(lrc) {
        if (!lrc) return [];
        var lines = lrc.split('\n');
        var result = [];
        var timeReg = /\[(\d{2}):(\d{2})\.(\d{2,3})\]/g;
        lines.forEach(function (line) {
            var matches = Array.from(line.matchAll(timeReg));
            if (matches.length > 0) {
                var text = line.replace(timeReg, '').trim();
                if (text) {
                    matches.forEach(function (match) {
                        var m = parseInt(match[1]);
                        var s = parseInt(match[2]);
                        var ms = parseInt(match[3]);
                        var time = m * 60 + s + ms / (match[3].length === 3 ? 1000 : 100);
                        result.push({ time: time, text: text });
                    });
                }
            }
        });
        return result.sort(function (a, b) { return a.time - b.time; });
    }

    // ── Audio element (persistent, attached to body) ────────
    var audio = document.getElementById('firefly-music-audio') || document.createElement('audio');
    audio.id = 'firefly-music-audio';
    audio.style.display = 'none';
    if (!audio.parentNode) document.body.appendChild(audio);

    // ── State ────────────────────────────────────────────────
    var state = {
        playlist: [],
        currentIndex: 0,
        // 歌单来源（切换标签）：sources 为名字列表，activeSource 为当前查看的歌单
        sources: [],
        activeSource: 0,
        // 正在播放的曲目，切歌单时用来判断它是否还在新列表里
        nowPlaying: null,
        // 面板当前展示的列表（与播放队列 state.playlist 分离）
        viewTracks: [],
        isPlaying: false,
        playMode: 0, // 0: list, 1: one, 2: random
        volume: localStorage.getItem('music-player-volume') !== null
            ? parseFloat(localStorage.getItem('music-player-volume'))
            : (config.volume || 0.7),
        isMuted: false,
        lyrics: [],
        lyricsStatus: 'loading',
        currentLrcIndex: -1,
        initialized: false,
        initializing: false,
        error: null
    };

    // Map config playMode string to number
    if (config.playMode === 'random') state.playMode = 2;
    else if (config.playMode === 'one') state.playMode = 1;
    else state.playMode = 0;

    // ── Event helpers ────────────────────────────────────────
    function emit(name, detail) {
        window.dispatchEvent(new CustomEvent(name, { detail: detail || {} }));
    }

    // ── Meting fetch ─────────────────────────────────────────
    /**
     * 按平台/类型/ID 拉一份歌单，主 API 失败再逐个 fallback。
     * 返回归一化后的曲目数组；全链失败时抛出。
     */
    async function fetchMetingTracks(server, type, id) {
        if (!config.meting) return [];
        var m = config.meting;
        var apis = [m.api].concat(m.fallbackApis || []);

        for (var i = 0; i < apis.length; i++) {
            var baseApi = apis[i];
            if (!baseApi) continue;
            try {
                var fetchUrl = baseApi
                    .replace(':server', server || m.server)
                    .replace(':type', type || m.type)
                    .replace(':id', encodeURIComponent(id || ''))
                    .replace(':r', Math.random());
                if (m.auth) fetchUrl += '&auth=' + m.auth;

                var res = await fetch(fetchUrl);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                var data = await res.json();

                if (Array.isArray(data) && data.length > 0) {
                    return data.map(function (item) {
                        return {
                            name: item.name || item.title || 'Unknown',
                            artist: item.artist || item.author || 'Unknown',
                            url: item.url,
                            pic: item.pic || item.cover || '',
                            lrc: item.lrc
                        };
                    });
                }
            } catch (e) {
                console.warn('Meting API failed for ' + baseApi, e);
            }
        }
        throw new Error('All Meting APIs failed');
    }

    // 平台名 → 自建接口的 platform 代码
    var SELF_PLATFORM = { netease: 'wy', tencent: 'tx', kugou: 'kg' };

    /**
     * 走本站自建接口 /api/music/playlist 拉歌单（QQ 用）。
     * 只拿 id/歌名/歌手/封面，直链在点播时再走 /api/music/resolve；
     * 歌词仍借 Meting 的 lrc 端点（实测 QQ 曲目的歌词可取）。
     */
    async function fetchSelfPlaylist(server, id) {
        var platform = SELF_PLATFORM[server] || server;
        var res = await fetch(
            '/api/music/playlist?platform=' + encodeURIComponent(platform)
                + '&id=' + encodeURIComponent(id)
        );
        var data = await res.json().catch(function () { return null; });
        if (!res.ok || !data || !Array.isArray(data.tracks) || data.tracks.length === 0) {
            throw new Error((data && data.error) || ('HTTP ' + res.status));
        }
        var lrcTpl = config.meting ? config.meting.api : '';
        return data.tracks.map(function (t) {
            return {
                name: t.name || 'Unknown',
                artist: t.artist || 'Unknown',
                // 直链留空，点播时解析
                url: '',
                pic: t.pic || '',
                lrc: lrcTpl
                    ? lrcTpl
                        .replace(':server', server)
                        .replace(':type', 'lrc')
                        .replace(':id', encodeURIComponent(t.id))
                        .replace(':r', String(Math.random()))
                    : undefined,
                // 供 resolveTrackUrl 使用
                self: { platform: platform, id: t.id, name: t.name || '', singer: t.artist || '' }
            };
        });
    }

    /** 点播时用 /api/music/resolve 取直链；失败抛出，由调用方提示 */
    async function resolveTrackUrl(track) {
        var s = track.self;
        var res = await fetch(
            '/api/music/resolve?platform=' + encodeURIComponent(s.platform)
                + '&id=' + encodeURIComponent(s.id)
                + '&name=' + encodeURIComponent(s.name || '')
                + '&singer=' + encodeURIComponent(s.singer || '')
                + '&quality=320k'
        );
        var data = await res.json().catch(function () { return null; });
        if (!res.ok || !data || !data.url) {
            throw new Error((data && data.error) || ('HTTP ' + res.status));
        }
        return data.url;
    }

    /** 取第 index 个歌单来源的曲目：本地直接返回，在线走对应解析链，结果进会话缓存 */
    async function fetchSourceTracks(index) {
        var src = state.sources[index];
        if (!src) return [];
        if (Object.prototype.hasOwnProperty.call(sourceCache, index)) {
            return sourceCache[index];
        }
        var tracks;
        if (src.local) {
            tracks = config.localPlaylist || [];
        } else if (src.api === 'self') {
            tracks = await fetchSelfPlaylist(src.server, src.id);
        } else {
            tracks = await fetchMetingTracks(src.server, 'playlist', src.id);
        }
        sourceCache[index] = tracks;
        return tracks;
    }

    // ── Lyrics ───────────────────────────────────────────────
    function loadLyrics(track) {
        state.lyrics = [];
        state.lyricsStatus = 'loading';
        state.currentLrcIndex = -1;

        if (!track.lrc) {
            state.lyricsStatus = 'none';
            emit('fm:lyrics', { lyrics: [], status: 'none' });
            return;
        }

        var isLrcUrl = /^(https?:)?\/\//.test(track.lrc)
            || track.lrc.startsWith('/')
            || /\.(lrc|txt)(\?|#|$)/i.test(track.lrc);

        if (isLrcUrl) {
            state.lyricsStatus = 'loading';
            emit('fm:lyrics', { lyrics: [], status: 'loading' });
            fetch(track.lrc)
                .then(function (r) { return r.text(); })
                .then(function (text) {
                    state.lyrics = parseLRC(text);
                    state.lyricsStatus = state.lyrics.length > 0 ? 'loaded' : 'none';
                    emit('fm:lyrics', { lyrics: state.lyrics, status: state.lyricsStatus });
                })
                .catch(function () {
                    state.lyrics = [];
                    state.lyricsStatus = 'failed';
                    emit('fm:lyrics', { lyrics: [], status: 'failed' });
                });
        } else {
            state.lyrics = parseLRC(track.lrc);
            state.lyricsStatus = state.lyrics.length > 0 ? 'loaded' : 'none';
            emit('fm:lyrics', { lyrics: state.lyrics, status: state.lyricsStatus });
        }
    }

    // ── Track loading ────────────────────────────────────────
    function startPlayback(autoPlay) {
        if (autoPlay) {
            audio.play().then(function () {
                state.isPlaying = true;
                emit('fm:play-state', { isPlaying: true });
            }).catch(function (e) {
                console.warn('Autoplay blocked:', e);
            });
        } else {
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
        }
    }

    function loadTrack(index, autoPlay) {
        if (index < 0 || index >= state.playlist.length) return;
        state.currentIndex = index;
        var track = state.playlist[index];
        state.nowPlaying = track;

        loadLyrics(track);

        emit('fm:track', { index: index, track: track, autoPlay: !!autoPlay });

        if (track.url) {
            audio.src = track.url;
            startPlayback(autoPlay);
            return;
        }

        if (track.self) {
            // 自建歌单只带 id，直链到点播才解析；不持久化，直链有有效期
            resolveTrackUrl(track).then(function (directUrl) {
                // 解析回来时用户可能已切歌，别把源抢回旧曲目
                if (state.nowPlaying !== track) return;
                audio.src = directUrl;
                startPlayback(autoPlay);
            }).catch(function (e) {
                console.warn('Resolve failed:', e);
                state.isPlaying = false;
                emit('fm:play-state', { isPlaying: false });
                emit('fm:error', { message: config.i18n.error });
            });
            return;
        }

        startPlayback(autoPlay);
    }

    // ── Playback controls ────────────────────────────────────
    function togglePlay() {
        if (audio.paused) {
            audio.play().then(function () {
                state.isPlaying = true;
                emit('fm:play-state', { isPlaying: true });
            });
        } else {
            audio.pause();
            state.isPlaying = false;
            emit('fm:play-state', { isPlaying: false });
        }
    }

    function playNext(auto) {
        if (state.playMode === 1 && auto) {
            audio.currentTime = 0;
            audio.play();
            return;
        }
        var nextIndex;
        if (state.playMode === 2) {
            nextIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            nextIndex = (state.currentIndex + 1) % state.playlist.length;
        }
        loadTrack(nextIndex, true);
    }

    function playPrev() {
        var prevIndex;
        if (state.playMode === 2) {
            prevIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            prevIndex = (state.currentIndex - 1 + state.playlist.length) % state.playlist.length;
        }
        loadTrack(prevIndex, true);
    }

    function setPlayMode(mode) {
        state.playMode = mode;
        emit('fm:mode', { playMode: mode });
    }

    function cyclePlayMode() {
        setPlayMode((state.playMode + 1) % 3);
    }

    function setVolume(val) {
        val = Math.max(0, Math.min(1, val));
        state.volume = val;
        state.isMuted = false;
        audio.volume = val;
        audio.muted = false;
        localStorage.setItem('music-player-volume', val.toString());
        emit('fm:volume', { volume: val, isMuted: false });
    }

    function toggleMute() {
        state.isMuted = !state.isMuted;
        audio.muted = state.isMuted;
        emit('fm:volume', { volume: state.volume, isMuted: state.isMuted });
    }

    function seek(percent) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(1, percent)) * audio.duration;
    }

    function seekToTime(time) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(time, audio.duration));
    }

    function playTrackByIndex(index) {
        if (index === state.currentIndex && !audio.paused) {
            togglePlay();
        } else {
            loadTrack(index, true);
        }
    }

    /**
     * 点列表里的某一首：这是用户主动点歌，此时才把播放队列换成当前展示的歌单。
     * （切换歌单标签本身不动队列，见 setSource）
     */
    function playViewTrack(index) {
        if (index < 0 || index >= state.viewTracks.length) return;
        if (state.playlist !== state.viewTracks) {
            state.playlist = state.viewTracks;
        }
        playTrackByIndex(index);
    }

    // ── Audio events → broadcast ─────────────────────────────
    audio.addEventListener('timeupdate', function () {
        if (isNaN(audio.duration)) return;
        var ct = audio.currentTime;
        var dur = audio.duration;
        var pct = (ct / dur) * 100;

        emit('fm:time', {
            currentTime: ct,
            duration: dur,
            progress: pct,
            currentTimeStr: formatTime(ct),
            durationStr: formatTime(dur)
        });

        // Lyrics sync
        if (state.lyrics.length > 0) {
            var idx = -1;
            for (var i = 0; i < state.lyrics.length; i++) {
                if (ct >= state.lyrics[i].time) idx = i;
                else break;
            }
            if (idx !== state.currentLrcIndex) {
                state.currentLrcIndex = idx;
                emit('fm:lrc-index', { index: idx });
            }
        }
    });

    audio.addEventListener('ended', function () {
        playNext(true);
    });

    audio.addEventListener('error', function () {
        state.error = 'Audio playback error';
        emit('fm:error', { message: state.error });
    });

    // ── 歌单来源（切换标签） ──────────────────────────────────
    var rawSources = Array.isArray(config.sources) ? config.sources : [];
    // 已加载歌单的会话内缓存：重复点选不再请求
    var sourceCache = {};

    function sourceMeta() {
        return rawSources.map(function (src) { return { label: src.label }; });
    }

    function initSources() {
        state.sources = rawSources;
        state.activeSource = 0;
    }

    /** 正在播放的曲目落在给定列表里的下标，找不到返回 -1 */
    function indexOfNowPlaying(tracks) {
        var now = state.nowPlaying;
        if (!now) return -1;
        for (var i = 0; i < tracks.length; i++) {
            if (tracks[i].name === now.name && tracks[i].artist === now.artist) return i;
        }
        return -1;
    }

    /**
     * 切换当前查看的歌单。只换面板展示的列表，不碰播放队列与 audio：
     * 正在播放的曲目继续播、播放队列保持，直到用户在新歌单里主动点歌才换队列。
     */
    async function setSource(index) {
        if (!state.sources.length) return;
        if (index < 0 || index >= state.sources.length) return;
        if (index === state.activeSource) return;

        state.activeSource = index;
        emit('fm:sources', {
            sources: sourceMeta(),
            activeIndex: index
        });

        // 切换歌单时保留当前列表，等新数据到位后由 renderPlaylist 整体替换；
        // 只有列表本来就是空的（首次加载 / 上次失败）才退回占位提示。
        // 原先无论有无内容都清空成一行「正在加载歌单…」，切换瞬间整块列表塌陷。
        var cached = Object.prototype.hasOwnProperty.call(sourceCache, index);
        if (!cached && state.viewTracks.length === 0) emit('fm:playlist-loading', { label: sourceMeta()[index] ? sourceMeta()[index].label : '' });

        var tracks = [];
        try {
            tracks = await fetchSourceTracks(index);
        } catch (e) {
            console.warn('Playlist source load failed:', e);
            emit('fm:error', { message: config.i18n.error });
        }

        state.viewTracks = tracks;
        emit('fm:playlist', {
            playlist: tracks,
            currentIndex: indexOfNowPlaying(tracks)
        });
    }

    // ── Init (idempotent) ────────────────────────────────────
    async function init() {
        if (state.initialized || state.initializing) return;
        state.initializing = true;

        try {
            initSources();

            if (state.sources.length > 0) {
                var defaultTracks = await fetchSourceTracks(state.activeSource);
                state.playlist = defaultTracks;
                state.viewTracks = defaultTracks;
            } else if (config.mode === 'meting' && config.meting) {
                state.playlist = await fetchMetingTracks(
                    config.meting.server,
                    config.meting.type,
                    config.meting.id
                );
            } else if (config.mode === 'local') {
                state.playlist = config.localPlaylist || [];
                state.viewTracks = state.playlist;
            }

            if (state.playlist.length > 0) {
                // Apply volume
                audio.volume = state.volume;

                var startIndex = 0;
                if (state.playMode === 2) {
                    startIndex = Math.floor(Math.random() * state.playlist.length);
                }

                state.initialized = true;

                emit('fm:init', {
                    playlist: state.playlist,
                    sources: sourceMeta(),
                    activeSource: state.activeSource,
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted
                });

                loadTrack(startIndex, false);
            } else {
                state.initialized = true;
                emit('fm:init', {
                    playlist: [],
                    sources: sourceMeta(),
                    activeSource: state.activeSource,
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted
                });
                emit('fm:error', { message: config.i18n.noSongs });
            }
        } catch (e) {
            console.error('Music Manager init error:', e);
            state.initialized = true;
            emit('fm:init', {
                playlist: [],
                sources: sourceMeta(),
                activeSource: state.activeSource,
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted
            });
            emit('fm:error', { message: config.i18n.error });
        } finally {
            state.initializing = false;
        }
    }

    // ── Public API ───────────────────────────────────────────
    window.__fireflyMusic = {
        init: init,
        getState: function () {
            var track = state.nowPlaying || state.playlist[state.currentIndex] || null;
            return {
                playlist: state.playlist,
                viewTracks: state.viewTracks,
                currentIndex: state.currentIndex,
                sources: sourceMeta(),
                activeSource: state.activeSource,
                track: track,
                isPlaying: state.isPlaying,
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted,
                currentTime: audio.currentTime,
                duration: audio.duration || 0,
                progress: audio.duration ? (audio.currentTime / audio.duration) * 100 : 0,
                currentTimeStr: formatTime(audio.currentTime),
                durationStr: formatTime(audio.duration),
                lyrics: state.lyrics,
                lyricsStatus: state.lyricsStatus,
                currentLrcIndex: state.currentLrcIndex,
                initialized: state.initialized,
                error: state.error
            };
        },
        togglePlay: togglePlay,
        playNext: function () { playNext(false); },
        playPrev: playPrev,
        cyclePlayMode: cyclePlayMode,
        setVolume: setVolume,
        toggleMute: toggleMute,
        seek: seek,
        seekToTime: seekToTime,
        playTrackByIndex: playTrackByIndex,
        playViewTrack: playViewTrack,
        loadTrack: loadTrack,
        setSource: setSource,
        // Re-sync all MusicPlayer widgets (called after Swup page transitions)
        resync: function () {
            if (!state.initialized) return;
            var widgets = document.querySelectorAll('.music-player-widget');
            widgets.forEach(function (w) {
                if (typeof w.__musicSync === 'function') {
                    try { w.__musicSync(); } catch (e) { /* noop */ }
                }
            });
        }
    };

    // ── Swup page transition hook: re-sync widgets after navigation ──
    // Per CLAUDE.md 4.4, only listen to `astro:page-load` (bridged by
    // @swup/astro). It fires once per navigation incl. first load — do NOT
    // also subscribe to `swup:contentReplaced` / `page:view` /
    // `content:replace`, which would trigger this 4× per navigation.
    function scheduleResync() {
        setTimeout(function () {
            if (window.__fireflyMusic) window.__fireflyMusic.resync();
        }, 100);
    }

    document.addEventListener('astro:page-load', scheduleResync);
})();
</script>
