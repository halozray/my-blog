---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@3.15.2/dist/waline.css" />
  <script type="module" is:inline define:vars={{ config }}>
    const cdnUrls = [
      'https://unpkg.com/@waline/client@3.15.2/dist/waline.js',
      'https://cdn.jsdelivr.net/npm/@waline/client@3.15.2/dist/waline.js'
    ];
    
    async function loadWaline(urls) {
      for (const url of urls) {
        try {
          const { init } = await import(url);
          init(config);
          return;
        } catch (error) {
          console.warn(`Failed to load Waline from ${url}:`, error);
        }
      }
      console.error('Failed to load Waline from all CDN sources');
    }
    
    loadWaline(cdnUrls);

    // 游客默认头像替换：头像走 libravatar 直链的人里，没在头像服务注册过的只会拿到
    // 服务自带默认图。用 ?d=404 探针分辨（404 = 没注册过），命中的换成配置里的
    // defaultAvatar。结果按邮箱哈希在 localStorage 缓存 7 天；QQ 头像、自设头像等
    // 非 libravatar 地址一律不碰。与主站 lanerc.me 同口径实现。
    (function() {
      const defAvatar = config.defaultAvatar;
      if (!defAvatar) return;
      const CACHE_KEY = 'wl-defav-v1';
      const TTL = 7 * 864e5;
      let cache = {};
      try { cache = JSON.parse(localStorage.getItem(CACHE_KEY) || '{}'); } catch (e) {}
      const probing = {};
      function probe(hash) {
        if (probing[hash]) return probing[hash];
        probing[hash] = new Promise((resolve) => {
          const img = new Image();
          img.onload = () => resolve(true);
          img.onerror = () => resolve(false);
          img.src = 'https://seccdn.libravatar.org/avatar/' + hash + '?d=404';
        }).then((has) => {
          cache[hash] = { has: has ? 1 : 0, t: Date.now() };
          try { localStorage.setItem(CACHE_KEY, JSON.stringify(cache)); } catch (e) {}
          return has;
        });
        return probing[hash];
      }
      function applyTo(img) {
        if (img.dataset.wlDefav) return;
        const m = (img.getAttribute('src') || '').match(/libravatar\.org\/avatar\/([0-9a-f]{32})/i);
        if (!m) return;
        const hash = m[1].toLowerCase();
        const hit = cache[hash];
        if (hit && Date.now() - hit.t < TTL) {
          if (!hit.has) { img.dataset.wlDefav = '1'; img.src = defAvatar; }
          return;
        }
        probe(hash).then((has) => {
          if (!has && img.isConnected && (img.getAttribute('src') || '').toLowerCase().includes(hash)) {
            img.dataset.wlDefav = '1';
            img.src = defAvatar;
          }
        });
      }
      function scan() {
        document.querySelectorAll('#waline img').forEach(applyTo);
      }
      const root = document.getElementById('waline');
      if (root && !root.dataset.wlDefavObs) {
        root.dataset.wlDefavObs = '1';
        new MutationObserver(scan).observe(root, {
          childList: true, subtree: true, attributes: true, attributeFilter: ['src'],
        });
      }
      scan();
    })();
  </script>
</div>
