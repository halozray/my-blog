---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/calendar.css";
import { LUNAR_INFO } from "@/utils/lunar-data";
import { SOLAR_TERMS } from "@/utils/solar-terms-data";

const title = "日历";
const description = "把文章、节假日、校历和自己的记录都钉在日子上。";

// 农历表与节气表体积固定、不随内容变化，直接内联，省一次请求
const payload = JSON.stringify({ lunarInfo: LUNAR_INFO, terms: SOLAR_TERMS });
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="calendar-head">
				<div>
					<h2 class="flex items-center gap-2 text-lg font-bold">
						<Icon name="material-symbols:calendar-month-rounded" />
						{title}
					</h2>
					<p class="text-sm opacity-70">{description}</p>
				</div>
				<div class="calendar-nav">
					<button type="button" data-cal-prev aria-label="上个月">‹ 上月</button>
					<div class="calendar-month-label" data-cal-label>…</div>
					<button type="button" data-cal-next aria-label="下个月">下月 ›</button>
					<button type="button" data-cal-today>回到今天</button>
				</div>
			</div>

			<div class="calendar-weekdays" aria-hidden="true">
				<span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span
					class="is-weekend">六</span
				><span class="is-weekend">日</span>
			</div>
			<div class="calendar-grid" data-cal-grid></div>

			<div class="calendar-legend" aria-hidden="true">
				<span><span class="calendar-mark kind-post"></span>文章</span>
				<span><span class="calendar-mark kind-seu"></span>东南大学校历</span>
				<span><span class="calendar-mark kind-record"></span>个人记录</span>
				<span><span class="calendar-mark kind-anniversary"></span>纪念日</span>
			</div>

			<div class="calendar-detail" data-cal-detail></div>

			<p class="calendar-footnote">
				数据来自本站文章与主站日历数据：法定节假日、东南大学校历、个人记录，
				另含站长生日（农历三月廿七）、主站纪念日与灵感屋纪念日。农历按 1900–2100
				历表在本地换算，节气表覆盖 2024–2030 年。
			</p>
		</div>
	</div>

	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
			<div class="calendar-count-head">
				<h3>近在眼前</h3>
				<p>
					接下来 60 天里最近的日子：节气、农历节日、公历节日、假期、校历、个人记录与纪念日，点一行跳到那天。
				</p>
			</div>
			<div class="calendar-countdown" data-cal-countdown></div>
		</div>
	</div>

	<script
		type="application/json"
		id="calendar-data"
		is:inline
		set:html={payload}
	></script>

	<script is:inline>
		// 事件数据全部在浏览器端取：本站两个静态 JSON 端点（节假日/校历/记录/纪念日 + 文章元数据）。
		// 本脚本与 #calendar-data 必须在 MainGridLayout 内部（#swup-container 里），
		// 否则 Swup 软导航时脚本不会随新页面带进来。
		function __initCalendar() {
			var el = document.getElementById("calendar-data");
			if (!el) return;
			var gridStamp = document.querySelector("[data-cal-grid]");
			if (!gridStamp) return;
			// 幂等：同一份 DOM 只初始化一次（reload 重跑与看门狗补跑可能撞车）
			if (gridStamp.dataset.calBound === "1") return;
			gridStamp.dataset.calBound = "1";

			var base;
			try {
				base = JSON.parse(el.textContent || "{}");
			} catch (e) {
				return;
			}
			var LUNAR_INFO = base.lunarInfo || [];
			var TERMS = base.terms || {};

			var KIND_GROUPS = [
				["holiday", "节假日"],
				["workday", "调休"],
				["seu", "校历"],
				["post", "文章"],
				["record", "个人记录"],
				["anniversary", "纪念日"],
			];

			var items = [];
			var index = {};

			function pad(n) {
				return (n < 10 ? "0" : "") + n;
			}
			function keyOf(y, m0, d) {
				return y + "-" + pad(m0 + 1) + "-" + pad(d);
			}
			function todayKey() {
				var t = new Date();
				return keyOf(t.getFullYear(), t.getMonth(), t.getDate());
			}
			function parseKey(k) {
				var p = k.split("-");
				return { y: +p[0], m: +p[1] - 1, d: +p[2] };
			}
			function escapeHtml(s) {
				return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
					return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
				});
			}

			// ---- 农历换算（与 src/utils/lunar.ts 同源算法）----
			function lLeapMonth(y) {
				return LUNAR_INFO[y - 1900] & 0xf;
			}
			function lLeapDays(y) {
				return lLeapMonth(y) ? (LUNAR_INFO[y - 1900] & 0x10000 ? 30 : 29) : 0;
			}
			function lMonthDays(y, m) {
				return LUNAR_INFO[y - 1900] & (0x10000 >> m) ? 30 : 29;
			}
			function lYearDays(y) {
				var s = 348;
				var info = LUNAR_INFO[y - 1900];
				for (var i = 0x8000; i > 0x8; i >>= 1) s += info & i ? 1 : 0;
				return s + lLeapDays(y);
			}
			function solarToLunar(y, m, d) {
				var offset = Math.round((Date.UTC(y, m - 1, d) - Date.UTC(1900, 0, 31)) / 86400000);
				var i;
				var temp = 0;
				for (i = 1900; i < 2101 && offset > 0; i++) {
					temp = lYearDays(i);
					offset -= temp;
				}
				if (offset < 0) {
					offset += temp;
					i--;
				}
				var year = i;
				var leapM = lLeapMonth(year);
				var isLeap = false;
				for (i = 1; i < 13 && offset > 0; i++) {
					if (leapM > 0 && i === leapM + 1 && !isLeap) {
						--i;
						isLeap = true;
						temp = lLeapDays(year);
					} else {
						temp = lMonthDays(year, i);
					}
					if (isLeap && i === leapM + 1) isLeap = false;
					offset -= temp;
				}
				if (offset === 0 && leapM > 0 && i === leapM + 1) {
					if (isLeap) isLeap = false;
					else {
						isLeap = true;
						--i;
					}
				}
				if (offset < 0) {
					offset += temp;
					--i;
				}
				return { year: year, month: i, day: offset + 1, leap: isLeap };
			}
			var LUNAR_MONTHS = ["正", "二", "三", "四", "五", "六", "七", "八", "九", "十", "冬", "腊"];
			var LUNAR_DIGITS = ["日", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十"];
			function lunarDayName(d) {
				if (d === 10) return "初十";
				if (d === 20) return "二十";
				if (d === 30) return "三十";
				return ["初", "十", "廿", "卅"][Math.floor(d / 10)] + LUNAR_DIGITS[d % 10];
			}
			function lunarMonthName(l) {
				return (l.leap ? "闰" : "") + LUNAR_MONTHS[l.month - 1] + "月";
			}
			var LUNAR_FESTIVALS = {
				"1-1": "春节",
				"1-15": "元宵节",
				"2-2": "龙抬头",
				"3-3": "上巳节",
				"5-5": "端午节",
				"7-7": "七夕节",
				"7-15": "中元节",
				"8-15": "中秋节",
				"9-9": "重阳节",
				"10-1": "寒衣节",
				"10-15": "下元节",
				"12-8": "腊八节",
				"12-23": "小年",
			};
			function lunarFestival(l) {
				if (l.leap) return "";
				if (l.month === 12 && l.day === lMonthDays(l.year, 12)) return "除夕";
				return LUNAR_FESTIVALS[l.month + "-" + l.day] || "";
			}
			function lunarOf(k) {
				var p = parseKey(k);
				return solarToLunar(p.y, p.m + 1, p.d);
			}
			function termOf(k) {
				return TERMS[k] || "";
			}

			// ---- 公历节日（与 src/utils/calendar-data.ts 的同名表一致）----
			var SOLAR_FESTIVALS = {
				"1-10": "中国人民警察节",
				"2-14": "情人节",
				"3-8": "妇女节",
				"3-12": "植树节",
				"3-15": "消费者权益日",
				"4-1": "愚人节",
				"4-15": "全民国家安全教育日",
				"4-22": "世界地球日",
				"4-23": "世界读书日",
				"5-4": "青年节",
				"5-12": "全国防灾减灾日",
				"5-19": "中国旅游日",
				"6-1": "儿童节",
				"6-6": "全国爱眼日",
				"6-26": "国际禁毒日",
				"7-1": "建党节",
				"7-7": "七七事变纪念日",
				"8-1": "建军节",
				"8-19": "中国医师节",
				"9-3": "抗战胜利纪念日",
				"9-10": "教师节",
				"9-18": "九一八事变纪念日",
				"9-30": "烈士纪念日",
				"10-10": "辛亥革命纪念日",
				"10-24": "程序员节",
				"10-25": "台湾光复日",
				"10-31": "万圣夜",
				"11-8": "记者节",
				"11-9": "全国消防日",
				"11-11": "光棍节",
				"12-4": "国家宪法日",
				"12-13": "国家公祭日",
				"12-20": "澳门回归纪念日",
				"12-24": "平安夜",
				"12-25": "圣诞节",
			};
			var SOLAR_WEEK_FESTIVALS = {
				"5-2-0": "母亲节",
				"5-3-0": "全国助残日",
				"6-3-0": "父亲节",
				"9-3-6": "全民国防教育日",
				"11-4-4": "感恩节",
			};
			function solarFestival(k) {
				var p = parseKey(k);
				var fixed = SOLAR_FESTIVALS[p.m + 1 + "-" + p.d];
				if (fixed) return fixed;
				var dow = new Date(p.y, p.m, p.d).getDay();
				var nth = Math.floor((p.d - 1) / 7) + 1;
				return SOLAR_WEEK_FESTIVALS[p.m + 1 + "-" + nth + "-" + dow] || "";
			}

			// ---- 事件索引 ----
			function rebuildIndex() {
				index = {};
				items.forEach(function (it) {
					if (!it || !it.date) return;
					if (!index[it.date]) index[it.date] = [];
					index[it.date].push(it);
				});
			}
			function dayEvents(k) {
				return index[k] || [];
			}
			function eventTitle(it) {
				if (it.kind === "holiday") {
					return it.name + (it.rest && it.rest > 1 ? " · 放假（连休 " + it.rest + " 天）" : " · 放假");
				}
				if (it.kind === "workday") return it.name + " · 调休上班";
				return it.name;
			}

			var grid = document.querySelector("[data-cal-grid]");
			var label = document.querySelector("[data-cal-label]");
			var detail = document.querySelector("[data-cal-detail]");
			var countdownEl = document.querySelector("[data-cal-countdown]");
			if (!grid || !label || !detail) return;

			var now = new Date();
			var cursor = { y: now.getFullYear(), m: now.getMonth() };
			var selected = todayKey();

			function renderDetail() {
				var list = dayEvents(selected);
				var p = parseKey(selected);
				var html = "<h3>" + p.y + " 年 " + (p.m + 1) + " 月 " + p.d + " 日</h3>";
				var ln = lunarOf(selected);
				var meta = "农历" + lunarMonthName(ln) + lunarDayName(ln.day);
				var tm = termOf(selected);
				if (tm) meta += " · " + tm;
				var fv = lunarFestival(ln);
				if (fv && fv !== tm) meta += " · " + fv;
				var sf = solarFestival(selected);
				if (sf && sf !== tm && sf !== fv) meta += " · " + sf;
				html += '<p class="calendar-lunar-meta">' + escapeHtml(meta) + "</p>";
				if (!list.length) {
					html += '<p class="calendar-empty">这一天还没有任何记录。</p>';
				} else {
					KIND_GROUPS.forEach(function (pair) {
						var group = list.filter(function (e) {
							return e.kind === pair[0];
						});
						if (!group.length) return;
						html += '<div class="calendar-detail-group"><div class="group-name">' + pair[1] + "</div>";
						group.forEach(function (e) {
							var inner = escapeHtml(eventTitle(e));
							html += e.url
								? '<a class="calendar-detail-item" href="' + e.url + '">' + inner + "</a>"
								: '<div class="calendar-detail-item">' + inner + "</div>";
						});
						html += "</div>";
					});
				}
				detail.innerHTML = html;
			}

			function render() {
				label.textContent = cursor.y + " 年 " + (cursor.m + 1) + " 月";
				var first = new Date(cursor.y, cursor.m, 1);
				var startOffset = (first.getDay() + 6) % 7; // 周一起始
				var start = new Date(cursor.y, cursor.m, 1 - startOffset);
				var html = "";
				var today = todayKey();
				for (var i = 0; i < 42; i++) {
					var d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
					var k = keyOf(d.getFullYear(), d.getMonth(), d.getDate());
					var evs = dayEvents(k);
					var isHoliday = evs.some(function (e) {
						return e.kind === "holiday";
					});
					var marks = "";
					var seen = {};
					evs.forEach(function (e) {
						if (!e.kind || seen[e.kind]) return;
						seen[e.kind] = 1;
						// 放假/调休用格子里的名字牌表达，不再重复画点
						if (e.kind === "holiday" || e.kind === "workday") return;
						marks += '<span class="calendar-mark kind-' + e.kind + '"></span>';
					});
					var hol = evs.filter(function (e) {
						return e.kind === "holiday" || e.kind === "workday";
					})[0];
					var cellLunar = lunarOf(k);
					var fest = termOf(k) || lunarFestival(cellLunar) || solarFestival(k);
					var lunarText = fest || (cellLunar.day === 1 ? lunarMonthName(cellLunar) : lunarDayName(cellLunar.day));
					html +=
						'<button type="button" class="calendar-cell' +
						(d.getMonth() !== cursor.m ? " is-out" : "") +
						(k === today ? " is-today" : "") +
						(k === selected ? " is-selected" : "") +
						(isHoliday ? " is-holiday" : "") +
						'" data-date="' + k + '">' +
						'<span class="calendar-day-num">' + d.getDate() + "</span>" +
						(hol
							? '<span class="calendar-holiday-name' +
								(hol.kind === "workday" ? " is-workday" : "") +
								'">' +
								escapeHtml(hol.name) +
								"</span>"
							: "") +
						'<span class="calendar-lunar' +
						(fest ? " is-fest" : "") +
						'">' +
						escapeHtml(lunarText) +
						"</span>" +
						'<span class="calendar-marks">' + marks + "</span>" +
						"</button>";
				}
				grid.innerHTML = html;
				renderDetail();
			}

			grid.addEventListener("click", function (ev) {
				var btn = ev.target.closest("[data-date]");
				if (!btn) return;
				selected = btn.getAttribute("data-date");
				var p = parseKey(selected);
				if (p.y !== cursor.y || p.m !== cursor.m) cursor = { y: p.y, m: p.m };
				render();
			});
			document.querySelector("[data-cal-prev]").addEventListener("click", function () {
				cursor.m--;
				if (cursor.m < 0) {
					cursor.m = 11;
					cursor.y--;
				}
				render();
			});
			document.querySelector("[data-cal-next]").addEventListener("click", function () {
				cursor.m++;
				if (cursor.m > 11) {
					cursor.m = 0;
					cursor.y++;
				}
				render();
			});
			document.querySelector("[data-cal-today]").addEventListener("click", function () {
				var t = new Date();
				cursor = { y: t.getFullYear(), m: t.getMonth() };
				selected = todayKey();
				render();
			});

			// ---- 近期倒计时：往后 60 天，取最近 6 条 ----
			function buildCountdown() {
				if (!countdownEl) return;
				var list = [];
				var seenHoliday = {};
				var base = new Date();
				base.setHours(0, 0, 0, 0);
				for (var off = 0; off <= 60; off++) {
					var d = new Date(base.getFullYear(), base.getMonth(), base.getDate() + off);
					var k = keyOf(d.getFullYear(), d.getMonth(), d.getDate());
					var tm = termOf(k);
					if (tm) list.push({ k: k, name: tm, tag: "节气" });
					var fv = lunarFestival(lunarOf(k));
					if (fv) list.push({ k: k, name: fv, tag: "农历" });
					var sf = solarFestival(k);
					if (sf) list.push({ k: k, name: sf, tag: "节日" });
					dayEvents(k).forEach(function (e) {
						if (e.kind === "holiday") {
							if (seenHoliday[e.name]) return;
							seenHoliday[e.name] = 1;
							list.push({ k: k, name: e.name, tag: "假期" });
								return;
						}
						if (e.kind === "seu") list.push({ k: k, name: e.name, tag: "校历" });
						else if (e.kind === "record") list.push({ k: k, name: e.name, tag: "记录" });
						else if (e.kind === "anniversary") list.push({ k: k, name: e.name, tag: "纪念日" });
					});
				}
				list = list.slice(0, 6);
				if (!list.length) {
					countdownEl.innerHTML = '<p class="calendar-empty">接下来 60 天里还没有排上的日子。</p>';
					return;
				}
				var week = ["日", "一", "二", "三", "四", "五", "六"];
				countdownEl.innerHTML = list
					.map(function (it) {
						var p = parseKey(it.k);
						var wd = week[new Date(p.y, p.m, p.d).getDay()];
						return (
							'<button type="button" class="cd-row" data-goto="' + it.k + '">' +
							'<span class="cd-tag">' + it.tag + "</span>" +
							'<span class="cd-name">' + escapeHtml(it.name) + "</span>" +
							'<span class="cd-date">' + (p.m + 1) + " 月 " + p.d + " 日 · 周" + wd + "</span>" +
							'<span class="cd-left" data-cd-left="' + it.k + '"></span>' +
							"</button>"
						);
					})
					.join("");
			}
			function tickCountdown() {
				if (!countdownEl) return;
				var nodes = countdownEl.querySelectorAll("[data-cd-left]");
				var nowMs = Date.now();
				nodes.forEach(function (n) {
					var p = parseKey(n.getAttribute("data-cd-left"));
					var diff = new Date(p.y, p.m, p.d).getTime() - nowMs;
					if (diff <= 0) {
						n.textContent = diff > -86400000 ? "就是今天" : "";
						return;
					}
					var days = Math.floor(diff / 86400000);
					var rest = diff - days * 86400000;
					var hh = Math.floor(rest / 3600000);
					var mm = Math.floor((rest % 3600000) / 60000);
					var ss = Math.floor((rest % 60000) / 1000);
					n.textContent = "还有 " + (days > 0 ? days + " 天 " : "") + pad(hh) + ":" + pad(mm) + ":" + pad(ss);
				});
			}
			if (countdownEl) {
				countdownEl.addEventListener("click", function (ev) {
					var btn = ev.target.closest("[data-goto]");
					if (!btn) return;
					selected = btn.getAttribute("data-goto");
					var p = parseKey(selected);
					cursor = { y: p.y, m: p.m };
					render();
					detail.scrollIntoView({ behavior: "smooth", block: "nearest" });
				});
				if (window.__calCountdownTimer) clearInterval(window.__calCountdownTimer);
				window.__calCountdownTimer = setInterval(tickCountdown, 1000);
			}

			// ---- 数据：本站两个静态 JSON 端点 ----
			async function fetchJson(url) {
				const response = await fetch(url, { cache: "no-cache" });
				if (!response.ok) throw new Error(url);
				return response.json();
			}
			function postItems(meta) {
				if (!Array.isArray(meta)) return [];
				return meta.map(function (p) {
					// published 是毫秒时间戳，按 +08 归到自然日
					var t = new Date(p.published + 8 * 3600 * 1000);
					var slug = String(p.id || "").replace(/\.[^.]+$/, "");
					return {
						date: t.toISOString().slice(0, 10),
						name: p.title,
						kind: "post",
						url: "/posts/" + slug + "/",
					};
				});
			}

			// ---- 运行时覆盖层：与 src/utils/calendar-data.ts 同源的客户端转换 ----
			// 构建期数据先立住，这一层成功才覆盖；任何一步失败都安静保留静态结果
			var RAW_BASE = "https://raw.githubusercontent.com/Misty-ui-source/Firefly/main/calendar-data/";

			function shiftKey(k, days) {
				var p = parseKey(k);
				var t = new Date(p.y, p.m, p.d + days);
				return keyOf(t.getFullYear(), t.getMonth(), t.getDate());
			}
			function convHolidays(list) {
				var sorted = list
					.filter(function (h) {
						return h && typeof h.date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(h.date);
					})
					.sort(function (a, b) {
						return a.date < b.date ? -1 : a.date > b.date ? 1 : 0;
					});
				// rest = 同名连续放假段总天数
				var rest = {};
				var runStart = 0;
				for (var i = 1; i <= sorted.length; i++) {
					var prev = sorted[i - 1];
					var next = sorted[i];
					var continues =
						next &&
						prev.type === "holiday" &&
						next.type === "holiday" &&
						prev.name === next.name &&
						shiftKey(prev.date, 1) === next.date;
					if (continues) continue;
					if (prev.type === "holiday") {
						for (var j = runStart; j < i; j++) rest[sorted[j].date] = i - runStart;
					}
					runStart = i;
				}
				return sorted.map(function (h) {
					if (h.type === "workday") {
						return { date: h.date, name: h.name, kind: "workday", isWorkday: true };
					}
					return { date: h.date, name: h.name, kind: "holiday", isOfficial: true, rest: rest[h.date] };
				});
			}
			function convSeu(list) {
				var out = [];
				list.forEach(function (item) {
					// 只展开 kind=event，term/holiday 两类跳过
					if (!item || item.kind !== "event" || !item.start || !item.end) return;
					var cursor = item.start;
					var guard = 0;
					while (cursor <= item.end && guard < 400) {
						out.push({ date: cursor, name: item.title, kind: "seu" });
						cursor = shiftKey(cursor, 1);
						guard++;
					}
				});
				return out;
			}
			function convRecords(list) {
				return list
					.filter(function (r) {
						return r && typeof r.date === "string";
					})
					.map(function (r) {
						return { date: r.date, name: r.title || "个人记录", kind: "record" };
					});
			}
			// 农历 → 公历：站长生日（农历三月廿七）逐年回推
			function lunarToSolarYear(year, month, day) {
				var start = new Date(year, 0, 1);
				for (var i = 0; i < 366; i++) {
					var t = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
					var l = solarToLunar(t.getFullYear(), t.getMonth() + 1, t.getDate());
					if (l.year === year && l.month === month && l.day === day && !l.leap) {
						return keyOf(t.getFullYear(), t.getMonth(), t.getDate());
					}
				}
				return "";
			}
			function anniversaryItems(years) {
				var out = [];
				years.forEach(function (year) {
					var solar = lunarToSolarYear(year, 3, 27);
					if (solar) out.push({ date: solar, name: "站长生日", kind: "anniversary" });
					out.push({ date: year + "-10-15", name: "主站纪念日", kind: "anniversary" });
					out.push({ date: year + "-11-05", name: "灵感屋纪念日", kind: "anniversary" });
				});
				return out;
			}

			// 只拉真正存在的年份文件：年份从已有数据里推导，不去猜
			// 只认节假日/调休两类——它们才是 holidays-<年份>.json 的来源；
			// 校历跨学年、纪念日与文章都另有出处，算进来会拉出不存在的年份文件
			function holidayYears() {
				var set = {};
				items.forEach(function (it) {
					if (!it || typeof it.date !== "string") return;
					if (it.kind !== "holiday" && it.kind !== "workday") return;
					if (/^\d{4}-/.test(it.date)) set[it.date.slice(0, 4)] = 1;
				});
				var list = Object.keys(set).sort();
				// 数据为空时退回当年，别把覆盖面丢光
				return list.length ? list : [String(new Date().getFullYear())];
			}

			function loadRaw() {
				var year = new Date().getFullYear();
				var years = holidayYears();
				var jobs = [fetchJson(RAW_BASE + "seu-calendar.json"), fetchJson(RAW_BASE + "personal-records.json")];
				years.forEach(function (y) {
					jobs.push(
						fetchJson(RAW_BASE + "holidays-" + y + ".json").catch(function () {
							return null;
						}),
					);
				});
				Promise.all(jobs)
					.then(function (res) {
						var seu = Array.isArray(res[0]) ? res[0] : null;
						var records = Array.isArray(res[1]) ? res[1] : [];
						if (!seu) return;
						var holidays = [];
						res.slice(2).forEach(function (list) {
							if (Array.isArray(list)) holidays = holidays.concat(list);
						});
						var merged = convHolidays(holidays)
							.concat(convSeu(seu), convRecords(records), anniversaryItems([year, year + 1]));
						items = items
							.filter(function (it) {
								return it.kind === "post";
							})
							.concat(merged);
						paint();
					})
					.catch(function () {});
			}

			function paint() {
				rebuildIndex();
				render();
				buildCountdown();
				tickCountdown();
			}

			var holidaysLoaded = false;
			var postsLoaded = false;
			function maybePaint() {
				if (holidaysLoaded && postsLoaded) {
					paint();
					// 静态数据立住之后再拉主站真源覆盖，失败就保留静态结果
					loadRaw();
				}
			}

			fetchJson("/api/holidays.json")
				.then(function (list) {
					items = items.filter(function (it) {
						return it.kind !== "post";
					});
					if (Array.isArray(list)) items = list.concat(items);
					holidaysLoaded = true;
					maybePaint();
				})
				.catch(function () {
					holidaysLoaded = true;
					maybePaint();
				});

			fetchJson("/api/allPostMeta.json")
				.then(function (meta) {
					items = items.filter(function (it) {
						return it.kind !== "post";
					});
					items = items.concat(postItems(meta));
					postsLoaded = true;
					maybePaint();
				})
				.catch(function () {
					postsLoaded = true;
					maybePaint();
				});
		}
		__initCalendar();
		// 看门狗：Swup 软导航后 DOM 在场但网格为空时补跑一次（注册只一次）
		if (!window.__calWatchdog) {
			window.__calWatchdog = true;
			var calRetry = function () {
				setTimeout(function () {
					var g = document.querySelector("[data-cal-grid]");
					if (g && !g.children.length && document.getElementById("calendar-data")) __initCalendar();
				}, 60);
			};
			document.addEventListener("swup:contentReplaced", calRetry);
			document.addEventListener("swup:content:replace", calRetry);
			document.addEventListener("swup:page:view", calRetry);
		}
	</script>
</MainGridLayout>
